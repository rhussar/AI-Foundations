# Copy to .env and fill in your own key. Never commit or submit the real .env.
# All model calls go through Portkey to OpenAI models.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: default model for every step (gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol or gpt-6-astra).
OPENAI_MODEL=gpt-5.6-luna
